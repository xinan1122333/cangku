# ── 数据库 ────────────────────────────────────────────────
# SQLite 文件路径，相对项目根目录解析；生产建议用绝对路径
DATABASE_PATH=./data/wms.db

# ── 会话签名密钥（生产必须替换成随机 32+ 字节） ────────────
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-change-me-please-replace-in-production

# 会话有效期（天）
SESSION_DAYS=7

# ── 初始管理员（仅 pnpm seed 使用） ────────────────────────
ADMIN_USERNAME=admin
# 留空则 seed 随机生成强密码并打印一次；生产建议留空并立即改密
ADMIN_PASSWORD=

# ── 部署（域名/HTTPS 阶段用） ──────────────────────────────
# 对外访问地址，用于日志与链接展示
PUBLIC_ORIGIN=http://localhost:3000
# 反向代理后面运行时设为 1，使 Cookie 使用 Secure
TRUST_PROXY=0
